// Harmony's Windows icon and version identity. Based on Yapfast's icon resource.
// Keep these version literals in sync with Cargo.toml; packaging tests enforce it.
// No macros/includes: build.rs uses llvm-rc -no-preprocess for cross builds.

1 ICON "harmony.ico"

1 VERSIONINFO
FILEVERSION 1,4,0,0
PRODUCTVERSION 1,4,0,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "Harmony contributors\0"
            VALUE "FileDescription", "Harmony\0"
            VALUE "FileVersion", "1.4.0\0"
            VALUE "InternalName", "Harmony\0"
            VALUE "OriginalFilename", "Harmony.exe\0"
            VALUE "ProductName", "Harmony\0"
            VALUE "ProductVersion", "1.4.0\0"
            VALUE "LegalCopyright", "Harmony contributors; based on Yapfast by wiredtenshi and contributors. GPL-3.0-or-later.\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
