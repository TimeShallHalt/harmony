// Yapfast presentation values. Keep shared widget behavior in the shared components.
// Disabled for comparisons with the inherited interface.
export global ClientStyle {
    in-out property <bool> enabled: true;
    in-out property <bool> system24;
    out property <length> panel-gap: self.system24 ? 12px : 0px;
    out property <length> divider-size: self.system24 ? 4px : 1px;
    // An open-licensed, bundled face gives every platform the same text metrics.
    in-out property <string> native-font: "DM Sans";
    // Empty/-1px inputs inherit native defaults; resetting preserves live bindings.
    in-out property <string> pack-font-family;
    in-out property <image> title-logo;
    in-out property <length> pack-text-size: -1px;
    in-out property <length> pack-sidebar-width: -1px;
    in-out property <length> pack-header-height: -1px;
    in-out property <length> pack-account-height: -1px;
    in-out property <length> pack-rail-tile: -1px;
    in-out property <length> pack-members-width: -1px;
    in-out property <length> pack-profile-width: -1px;
    in-out property <length> pack-channel-row-height: -1px;
    in-out property <length> pack-message-gap: -1px;
    in-out property <length> pack-message-group-gap: -1px;
    in-out property <length> pack-composer-height: -1px;
    in-out property <length> pack-composer-padding: -1px;
    in-out property <length> pack-composer-gutter: -1px;
    in-out property <length> pack-title-height: -1px;
    in-out property <length> pack-title-inset: -1px;
    in-out property <length> pack-title-text-size: -1px;
    out property <string> font-family: self.pack-font-family != "" ? self.pack-font-family
        : self.system24 ? "DM Mono" : (self.enabled ? self.native-font : "Atkinson Hyperlegible Next");
    out property <length> text-size: self.pack-text-size >= 0px ? self.pack-text-size : (self.enabled ? 15px : 16px);
    out property <length> sidebar-width: self.pack-sidebar-width >= 0px ? self.pack-sidebar-width : (self.enabled ? 304px : 240px);
    // Discord's header rows: 48px between its outline and the line under them, 50px with both.
    out property <length> header-height: self.pack-header-height >= 0px ? self.pack-header-height : (self.enabled ? 50px : 48px);
    out property <length> account-inset: self.enabled ? 8px : 0px;
    out property <length> account-height: self.pack-account-height >= 0px ? self.pack-account-height : (self.system24 ? 48px : self.enabled ? 57px : 56px);
    out property <length> rail-tile: self.pack-rail-tile >= 0px ? self.pack-rail-tile : (self.enabled ? 40px : 48px);
    // Discord's folders are 48px tiles between its 40px servers, 8px apart in both.
    out property <length> folder-tile: 48px;
    out property <length> folder-radius: self.enabled ? 16px : 16px;
    // Discord's member list: its 1px edge and 264px of rows.
    out property <length> members-width: self.pack-members-width >= 0px ? self.pack-members-width : (self.enabled ? 265px : 240px);
    out property <length> profile-width: self.pack-profile-width >= 0px ? self.pack-profile-width : (self.enabled ? 320px : 300px);
    out property <length> dm-row-height: 42px;
    out property <length> channel-row-height: self.pack-channel-row-height >= 0px ? self.pack-channel-row-height : (self.enabled ? 32px : 34px);
    out property <length> message-gap: self.pack-message-gap >= 0px ? self.pack-message-gap : (self.enabled ? 0px : 3px);
    out property <length> message-group-gap: self.pack-message-group-gap >= 0px ? self.pack-message-group-gap : (self.enabled ? 16px : 14px);
    out property <length> profile-inset: self.enabled ? 8px : 0px;
    out property <length> composer-height: self.pack-composer-height >= 0px ? self.pack-composer-height : (self.enabled ? 58px : 48px);
    out property <length> composer-padding: self.pack-composer-padding >= 0px ? self.pack-composer-padding : (self.enabled ? 18px : 12px);
    out property <length> composer-gutter: self.pack-composer-gutter >= 0px ? self.pack-composer-gutter : (self.enabled ? 8px : 16px);
    out property <length> composer-button-inset: self.enabled ? 14px : 8px;
    // What opens a channel's history in Discord: its welcome block, in the
    // server's first channel and in any other.
    out property <length> intro-server-height: 167px;
    out property <length> intro-channel-height: 203px;
    // Window chrome shares these metrics with the content inset and resize handles.
    // Its colours stay in Theme, so built-in themes and the live editor apply together.
    out property <length> title-height: self.pack-title-height >= 0px ? self.pack-title-height : (self.system24 ? 26px : 32px);
    out property <length> caption-width: self.enabled ? 36px : 44px;
    out property <length> caption-icon-size: self.enabled ? 12px : 16px;
    out property <length> title-inset: self.pack-title-inset >= 0px ? self.pack-title-inset : (16px);
    out property <length> title-text-size: self.pack-title-text-size >= 0px ? self.pack-title-text-size : (12px);
    out property <length> title-brand-width: 140px;
    out property <length> title-drag-threshold: 3px;
    out property <length> title-rule: 1px;
    out property <length> resize-edge: 5px;
    out property <length> resize-corner: 8px;
    out property <length> settings-width: self.enabled ? 1400px : 1080px;
    out property <length> settings-height: self.enabled ? 100000px : 800px;
    out property <length> settings-margin: self.enabled ? 96px : 80px;
}
