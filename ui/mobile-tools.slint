import { MobileStyle } from "mobile-style.slint";
import { ListView } from "scrollview.slint";

export struct ToolHit {
    id: string, channel: string, channel-label: string, author: string, initial: string,
    body: string, time: string, avatar: image,
}

component ToolIcon inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    callback clicked();
    width: 44px; height: 44px; border-radius: 22px;
    background: hit.pressed ? MobileStyle.raised : transparent;
    accessible-role: button; accessible-label: label;
    accessible-action-default => {root.clicked();}
    Image { x: (parent.width - self.width)/2; y: (parent.height - self.height)/2; width: 22px; height: 22px; source: root.icon; colorize: MobileStyle.text; }
    hit := TouchArea { clicked => {root.clicked();} }
}

component ScopePill inherits Rectangle {
    in property <string> label;
    in property <bool> active;
    in property <image> icon;
    callback clicked();
    height: 34px; width: pill.preferred-width; border-radius: 17px;
    background: active ? MobileStyle.selected : (hit.pressed ? MobileStyle.raised : MobileStyle.field);
    accessible-role: button; accessible-label: label;
    accessible-action-default => {root.clicked();}
    pill := HorizontalLayout { cross-axis-alignment: center;padding-left: 11px; padding-right: 11px; spacing: 6px; alignment: center;
        Image { width: 15px; height: 15px; source: root.icon; colorize: MobileStyle.secondary; }
        Text { text: root.label; color: root.active ? MobileStyle.text : MobileStyle.secondary; font-size: 13px; font-weight: 650; vertical-alignment: center; }
    }
    hit := TouchArea {clicked => {root.clicked();}}
}

component ResultRow inherits Rectangle {
    in property <ToolHit> hit;
    callback chosen();
    height: content.preferred-height + 24px;
    accessible-role: button; accessible-label: hit.author + ", " + hit.body;
    accessible-action-default => {root.chosen();}
    background: pointer.pressed ? MobileStyle.raised : MobileStyle.panel;
    content := HorizontalLayout { cross-axis-alignment: start; x: 14px; width: parent.width - 28px; y: 12px; height: self.preferred-height; spacing: 10px;
        Rectangle { width: 36px; height: 36px; border-radius: 18px; clip: true; background: MobileStyle.raised;
            if root.hit.avatar.width > 0: Image {source: root.hit.avatar; image-fit: cover;}
            if root.hit.avatar.width == 0: Text { horizontal-alignment: center; vertical-alignment: center; text: root.hit.initial; color: MobileStyle.text; font-weight: 650; }
        }
        VerticalLayout { spacing: 3px;
            HorizontalLayout { cross-axis-alignment: center; spacing: 6px;
                Text { text: root.hit.author; color: MobileStyle.text; font-size: 15px; font-weight: 700; overflow: elide; }
                Rectangle {horizontal-stretch: 1;}
                Text { text: root.hit.time; color: MobileStyle.muted; font-size: 11px; vertical-alignment: center; }
            }
            Text { text: root.hit.body; color: MobileStyle.secondary; font-size: 14px; wrap: word-wrap; max-lines: 3; overflow: elide; }
            if root.hit.channel-label != "": Text { text: root.hit.channel-label; color: MobileStyle.muted; font-size: 12px; overflow: elide; }
        }
    }
    Rectangle { y: parent.height - 1px; height: 1px; background: MobileStyle.line; }
    pointer := TouchArea {clicked => {root.chosen();}}
}

export component ToolsPanel inherits Rectangle {
    in property <string> mode;
    in property <string> channel;
    in property <string> note;
    in property <bool> can-search-server;
    in property <bool> busy;
    in property <bool> more;
    in property <[ToolHit]> hits;
    callback command(string,string,string);
    private property <string> query;
    private property <bool> server-scope;
    private property <bool> searched;
    background: MobileStyle.canvas;
    function submit() {
        unfocus.focus();
        root.searched = true;
        root.command("submit",root.query,root.server-scope ? "server" : "channel");
    }
    function change-scope(wide: bool) {
        if root.server-scope != wide {
            root.server-scope = wide;
            if root.searched { root.submit(); }
        }
    }
    changed mode => {
        root.query = "";
        root.searched = false;
        root.server-scope = false;
    }
    TouchArea {}
    unfocus := FocusScope {}
    VerticalLayout {
        Rectangle { height: 58px; background: MobileStyle.panel;
            HorizontalLayout { cross-axis-alignment: center; padding-left: 3px; padding-right: 10px; spacing: 4px;
                ToolIcon { label: "Back to conversation"; icon: @image-url("icons/chevron-left.svg"); clicked => {root.command("close","","");} }
                if root.mode == "search": Rectangle { height: 38px; horizontal-stretch: 1; border-radius: 19px; background: MobileStyle.field;
                    HorizontalLayout { cross-axis-alignment: center; padding-left: 12px; padding-right: 3px; spacing: 8px;
                        Image { source: @image-url("icons/search.svg"); colorize: MobileStyle.muted; width: 18px; height: 18px; }
                        Rectangle { horizontal-stretch: 1; height: parent.height;
                            if root.query == "" && search-input.preedit-text == "": Text {x:0px; y:0px; width:parent.width; height:parent.height; horizontal-alignment:left; text: "Search messages"; color: MobileStyle.muted; font-size: 15px; vertical-alignment: center; }
                            search-input := TextInput { x:0px; y:0px; width:parent.width; height: parent.height; horizontal-alignment:left; text <=> root.query; color: MobileStyle.text; font-size: 15px; single-line: true; vertical-alignment: center; accessible-label: "Search messages"; accepted => {root.submit();} }
                        }
                        if root.query != "": ToolIcon {
                            icon: @image-url("icons/x.svg"); label: "Clear search"; width: 32px; height: 32px;
                            clicked => {root.query=""; root.searched=false;root.command("submit","","channel");search-input.focus();}
                        }
                    }
                }
                if root.mode == "search": ToolIcon {label:"Run search";icon:@image-url("icons/arrow-right.svg");clicked => {root.submit();}}
                if root.mode == "pins": Text {text:"Pinned messages";color:MobileStyle.text;font-size:20px;font-weight:700;vertical-alignment:center;horizontal-stretch:1; }
            }
        }
        if root.mode == "search" && root.can-search-server: Rectangle { height: 47px; background: MobileStyle.panel;
            HorizontalLayout { cross-axis-alignment: center; padding-left: 14px; padding-right: 14px; spacing: 7px; alignment: start;
                ScopePill { label: "This channel"; active: !root.server-scope; icon: @image-url("icons/hash.svg"); clicked => {root.change-scope(false);} }
                ScopePill { label: "Entire server"; active: root.server-scope; icon: @image-url("icons/search.svg"); clicked => {root.change-scope(true);} }
            }
        }
        Rectangle { height: 1px; background: MobileStyle.line; }
        if root.mode == "pins" && root.hits.length > 0: Rectangle { height: 36px;
            Text { x: 16px; width: parent.width - 32px; height: parent.height; text: root.channel; color: MobileStyle.muted; font-size: 13px; vertical-alignment: center; }
        }
        if root.hits.length > 0 && root.note != "": Rectangle { height: 38px;
            Text { x: 16px; text: root.note; color: MobileStyle.secondary; font-size: 13px; vertical-alignment: center; }
        }
        if root.hits.length > 0: ListView {
            for item in root.hits: ResultRow { hit: item; chosen => { root.command("jump",item.id,item.channel); } }
        }
        if root.hits.length == 0: Rectangle { vertical-stretch: 1;
            VerticalLayout { padding-left: 30px; padding-right: 30px; spacing: 13px; alignment: center;
                Rectangle { height: 52px;
                    Rectangle {x:(parent.width - self.width)/2;width:52px;height:52px;border-radius:18px;background:MobileStyle.raised;
                        Image {x:14px;y:14px;width:24px;height:24px;source:root.mode=="pins"?@image-url("icons/pin.svg"):@image-url("icons/search.svg");colorize:MobileStyle.secondary;}
                    }
                }
                Text { text: root.busy ? (root.mode=="pins" ? "Loading pinned messages…" : "Searching…")
                    : root.note != "" ? root.note : (root.mode=="pins" ? "No pinned messages yet." : "Search " + (root.server-scope ? "this server" : root.channel));
                    color:MobileStyle.text;font-size:17px;font-weight:650;horizontal-alignment:center;wrap:word-wrap; }
                if root.mode == "search" && root.note == "" && !root.busy: Text { text:"Search for words or use from:, has: and before: to narrow the results."; color:MobileStyle.muted; font-size:14px; horizontal-alignment:center; wrap:word-wrap; }
            }
        }
        if root.hits.length==0 && root.note!="" && !root.busy: Rectangle {height:48px; background:MobileStyle.panel;
            Text {text:root.mode=="pins" ? "Refresh" : "Search again"; color:MobileStyle.accent-text; font-size:14px; font-weight:650;
                horizontal-alignment:center; vertical-alignment:center;}
            accessible-role:button; accessible-label:root.mode=="pins" ? "Refresh pinned messages" : "Search again";
            accessible-action-default=>{root.command("retry","","");}
            TouchArea {clicked=>{root.command("retry","","");}}
        }
        if root.more: Rectangle { height: 48px; background: MobileStyle.panel;
            Text {text:root.busy?"Searching…":"More results";color:MobileStyle.accent-text;font-size:14px;font-weight:650;horizontal-alignment:center;vertical-alignment:center;}
            TouchArea {enabled:!root.busy; clicked=>{root.command("more","","");}}
            accessible-role:button;accessible-label:"More results";accessible-action-default=>{if !root.busy {root.command("more","","");}}
        }
    }
}
