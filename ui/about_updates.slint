import { Theme, Label } from "theme.slint";
import { SettingsTitle, SettingsHeading } from "settings.slint";
import { ActionButton } from "controls.slint";

export global HarmonyAbout {
    in-out property <string> running-info;
    callback copy-diagnostics;
}
export component AboutUpdatesSettings inherits VerticalLayout {
    in property <bool> preview;
    spacing: 16px;
    SettingsTitle { text: "About"; }
    SettingsHeading { text: "RUNNING HARMONY BUILD"; }
    Text { text: HarmonyAbout.running-info; color: Theme.text; font-size: 14px; wrap: word-wrap; accessible-label: "Running build information"; }
    HorizontalLayout {
        alignment: start;
        ActionButton { text: "Copy diagnostics"; icon: @image-url("icons/copy.svg"); clicked => { HarmonyAbout.copy-diagnostics(); } }
    }
    Label { text: "Diagnostics contain only public version/build, commit, platform, architecture, upstream and license information. No credentials, account IDs, messages or local paths."; }
    Rectangle { height: 1px; background: Theme.edge; }
    SettingsHeading { text: "UPDATE STATUS"; }
    Text { text: "Updater not included in this build."; color: Theme.text; font-size: 14px; accessible-label: "Update status"; }
    Label { text: "No update checks, downloads, background update tasks or installation on exit. Updating is manual; this build does not change your installation."; }
}
