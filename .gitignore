# Private working material, kept on this machine but out of the repository:
# old plans and records (docs/archive), measurement data, experiments, the beta server's
# deployment, and the design and product notes. scripts/warm-worktree copies
# them into new worktrees.
/docs/archive/
/docs/experiments/
/docs/measurements/*
!/docs/measurements/README.md
/experiments/
/deploy/
/DESIGN.md
/PRODUCT.md

# Local credentials, runtime data and installed/debug binaries are not source.
.env
.env.*
!.env.example
!.env.sample
/data/
/layout.json
/session.json
/credentials.json
/yapfast.log
/*.exe
/*.dll
/*.pdb

# Android build products, local toolchains and signing material
/android/.gradle/
/android/local.properties
/android/**/build/
/android/out/
*.jks
*.keystore
